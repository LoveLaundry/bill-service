# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
# Alternative alias:
# DATABASE_URL=mongodb://localhost:27017

MONGO_DB_NAME=love_laundry_bills

# ─── Security ────────────────────────────────────────────────────────────────
# MUST match the JWT_SECRET in user-service
JWT_SECRET=super-secret-jwt-key-love-laundry-2026

# MUST match the MASTER_KEY in ALL services
MASTER_KEY=default-secret-master-key-love-laundry-2026
